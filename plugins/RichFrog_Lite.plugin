_DENS = [None]


def dp(v):
    if _DENS[0] is None:
        from org.telegram.messenger import AndroidUtilities
        try:
            _DENS[0] = float(AndroidUtilities.density)
        except Exception:
            _DENS[0] = float(AndroidUtilities.dp(1000.0)) / 1000.0
    if v == 0:
        return 0
    return int(math.ceil(_DENS[0] * float(v)))


def _ih(obj):
    return int(jclass("java.lang.System").identityHashCode(obj))


def clean_phone(s):
    return "".join(ch for ch in str(s) if ch.isdigit())


def fmt_phone(d):
    d = clean_phone(d)
    if d.startswith("888") and len(d) == 11:
        return "+888 %s %s" % (d[3:7], d[7:11])
    return "+" + d


def to_int(value, default):
    try:
        return int(str(value).strip())
    except Exception:
        return default


def my_id():
    from org.telegram.messenger import UserConfig
    return int(UserConfig.getInstance(UserConfig.selectedAccount).getClientUserId())


def java_abstract(cls):
    try:
        from java.lang.reflect import Modifier
        return Modifier.isAbstract(cls.getModifiers())
    except Exception:
        return False


def level_threshold(level):
    """Очки, с которых начинается уровень. Кривая подогнана под данные Telegram:
    72 ур. = 894.4K, 73 ур. = 907.6K. Поменяй под себя при необходимости."""
    if level <= 1:
        return 0
    return int(round(9522.614 * (level ** 1.06216) / 100.0)) * 100


def level_from_points(points):
    level = 1
    while level < MAX_LEVEL and level_threshold(level + 1) <= points:
        level += 1
    return level


def fmt_k(n):
    n = int(n)
    if n >= 1000000:
        s = "%.1f" % (n / 1000000.0)
        suffix = "M"
    elif n >= 1000:
        s = "%.1f" % (n / 1000.0)
        suffix = "K"
    else:
        return str(n)
    if s.endswith(".0"):
        s = s[:-2]
    return s + suffix


def fmt_pct(permille):
    try:
        v = float(permille) / 10.0
        return ("%g" % v) + "%"
    except Exception:
        return ""


_DARK = [True]


_ACC = [DEFAULT_ACCENT]


def _over(base, ov):
    """Альфа-композиция ov поверх base (ARGB)."""
    b = int(base) & 0xFFFFFFFF
    o = int(ov) & 0xFFFFFFFF
    ba, oa = (b >> 24) / 255.0, (o >> 24) / 255.0
    ra = oa + ba * (1.0 - oa)
    if ra <= 0:
        return 0

    def ch(sh):
        return int(round((((o >> sh) & 0xFF) * oa + ((b >> sh) & 0xFF) * ba * (1.0 - oa)) / ra))

    return signed((int(round(ra * 255)) << 24) | (ch(16) << 16) | (ch(8) << 8) | ch(0))


def _tint(c, alpha):
    return signed((int(alpha) << 24) | (int(c) & 0xFFFFFF))


def darken(c, f):
    c = int(c) & 0xFFFFFFFF
    r = int(((c >> 16) & 0xFF) * (1 - f))
    g = int(((c >> 8) & 0xFF) * (1 - f))
    b = int((c & 0xFF) * (1 - f))
    return signed((0xFF << 24) | (r << 16) | (g << 8) | b)


def lighten(c, f):
    c = int(c) & 0xFFFFFFFF
    a = (c >> 24) & 0xFF
    r = (c >> 16) & 0xFF
    g = (c >> 8) & 0xFF
    b = c & 0xFF
    r = int(r + (255 - r) * f)
    g = int(g + (255 - g) * f)
    b = int(b + (255 - b) * f)
    return signed((a << 24) | (r << 16) | (g << 8) | b)


def _orient(name):
    try:
        return getattr(GradientDrawable.Orientation, name)
    except Exception:
        return getattr(jclass("android.graphics.drawable.GradientDrawable$Orientation"), name)


def _grad(colors, orient, radius_px=None, radii=None):
    g = GradientDrawable()
    g.setOrientation(_orient(orient))
    g.setColors(jarray(jint)([signed(c) for c in colors]))
    if radii is not None:
        g.setCornerRadii(jarray(jfloat)([float(x) for x in radii]))
    elif radius_px is not None:
        g.setCornerRadius(float(radius_px))
    return g


def set_bg(view, drawable):
    """setBackground, но без сброса паддингов (LayerDrawable меняет padding вью)."""
    l, t, r, b = view.getPaddingLeft(), view.getPaddingTop(), view.getPaddingRight(), view.getPaddingBottom()
    view.setBackground(drawable)
    view.setPadding(l, t, r, b)


# iOS «Liquid Glass» как на референсе: тонкая кромка, яркие углы, короткие «искры» по верхней и нижней грани
BLUE = 0xFFEAEFF7   # акцент: холодный светло-серый


def _with_alpha(c, a):
    return signed((int(a) << 24) | (int(c) & 0xFFFFFF))


def argb(a, r, g, b):
    return signed((int(max(0, min(255, a))) << 24) | (int(max(0, min(255, r))) << 16)
                  | (int(max(0, min(255, g))) << 8) | int(max(0, min(255, b))))


def mix(a, b, t):
    return a + (b - a) * max(0.0, min(1.0, t))


def _backdrop_layer(bmp, W, H, radii):
    """Слой «то, что за шторкой»: сильно размытый снимок экрана, подсвеченный; двигается вместе с шторкой."""
    from android.graphics import BitmapShader, ColorMatrixColorFilter, Matrix, Shader
    from android.graphics.drawable.shapes import RoundRectShape
    shader = BitmapShader(bmp, Shader.TileMode.CLAMP, Shader.TileMode.CLAMP)
    sd = ShapeDrawable(RoundRectShape(jarray(jfloat)([float(x) for x in radii]), None, None))
    p = sd.getPaint()
    p.setShader(shader)
    p.setAntiAlias(True)
    p.setFilterBitmap(True)
    k = 2.7  # усиление: светлые места фона становятся заметно светлее, тёмные остаются тёмными
    p.setColorFilter(ColorMatrixColorFilter(jarray(jfloat)([
        k, 0, 0, 0, 0,
        0, k, 0, 0, 0,
        0, 0, k, 0, 0,
        0, 0, 0, 1, 0])))
    sd.setAlpha(135)
    info = {"bd": sd, "shader": shader, "bw": int(bmp.getWidth()), "bh": int(bmp.getHeight()),
            "W": float(W), "H": float(H)}
    backdrop_move(info, float(H) * 0.5)
    return sd, info


def backdrop_move(info, sheet_top_px):
    """Снимок фона стоит на месте, а окно шторки скользит по нему: свет внутри меняется по ходу движения."""
    try:
        from android.graphics import Matrix
        m = Matrix()
        m.setScale(info["W"] / info["bw"], info["H"] / info["bh"])
        m.postTranslate(0.0, -float(sheet_top_px))
        info["shader"].setLocalMatrix(m)
        info["bd"].invalidateSelf()
    except Exception as e:
        log("RichFrog backdrop move: " + str(e))


def _ios_glass(radius_dp, body_colors, rim_colors, radii=None, top_only=False, sheen=0x1EFFFFFF,
               parts=None, glints=True, backdrop=None):
    r = float(dp(radius_dp))
    w = max(1, dp(1))
    if radii is None:
        rim_d = _grad(rim_colors, "TL_BR", r)
        body = _grad(body_colors, "TL_BR", max(0.0, r - w))
        top = _grad([sheen, 0x00FFFFFF], "TOP_BOTTOM", max(0.0, r - w))
        inner = GradientDrawable()
        inner.setCornerRadius(max(0.0, r - w))
        rin = [max(0.0, r - w)] * 8
    else:
        rin = [x - w if x > 0 else 0.0 for x in radii]
        rim_d = _grad(rim_colors, "TL_BR", radii=radii)
        body = _grad(body_colors, "TL_BR", radii=rin)
        top = _grad([sheen, 0x00FFFFFF], "TOP_BOTTOM", radii=rin)
        inner = GradientDrawable()
        inner.setCornerRadii(jarray(jfloat)([float(x) for x in rin]))
    inner.setColor(0)
    inner.setStroke(max(1, dp(1)), signed(0x1CFFFFFF))
    layer_list = [rim_d, body]
    if backdrop is not None:
        try:
            bmp, W, H = backdrop
            bd, info = _backdrop_layer(bmp, W, H, rin)
            layer_list.append(bd)
            if parts is not None:
                parts["bdinfo"] = info
        except Exception as e:
            log("RichFrog backdrop layer: " + str(e))
    top_idx = len(layer_list)
    layer_list.append(top)
    layer_list.append(inner)
    inner_count = len(layer_list)
    specs = []
    if glints:
        for g in ((Gravity.TOP,) if top_only else (Gravity.TOP, Gravity.BOTTOM)):
            layer_list.append(_grad([0x00FFFFFF, 0x22FFFFFF, 0xFFFFFFFF, 0x22FFFFFF, 0x00FFFFFF], "LEFT_RIGHT", 0.0))
            specs.append((len(layer_list) - 1, g))
    layers = LayerDrawable(jarray(Drawable)(layer_list))
    bottom = 0 if top_only else w
    for i in range(1, inner_count):
        layers.setLayerInset(i, w, w, w, bottom)
    try:
        layers.setLayerGravity(top_idx, Gravity.TOP)
        layers.setLayerHeight(top_idx, int(max(r * 1.2, dp(14))))
        gap = int(max(r, dp(16)))
        for i, g in specs:
            layers.setLayerInset(i, gap, 0, gap, 0)
            layers.setLayerGravity(i, g)
            layers.setLayerHeight(i, max(2, int(dp(1.5))))
    except Exception:
        pass
    if parts is not None:
        parts.update({"rim": rim_d, "body": body, "top": top})
    return layers


_RIM_IOS = [0xF2FFFFFF, 0x26FFFFFF, 0x0DFFFFFF, 0x59FFFFFF, 0xDDFFFFFF]


def glass(color, radius_dp):
    """Чёрное дымчатое жидкое стекло: тонкая светлая кромка, чёрная заливка с лёгким светом сверху-слева."""
    a = (int(color) >> 24) & 0xFF
    tail = 0xB8000000 if a < 0x80 else 0x9A000000
    return _ios_glass(radius_dp, [0x2EFFFFFF, signed(0x66000000), signed(tail)], _RIM_IOS)


def accent_pill(accent, radius_dp):
    """Главные кнопки: тёмно-серое стекло, чуть светлее карточек."""
    return _ios_glass(radius_dp, [signed(0x80B4B4BC), signed(0x70505058), signed(0xA0202024)], _RIM_IOS,
                      sheen=0x40FFFFFF)


def sheet_bg_parts(backdrop=None):
    r = float(dp(30))
    radii = [r, r, r, r, r, r, r, r]
    parts = {}
    d = _ios_glass(30, [signed(0xF2141418), signed(0xF40A0A0C), signed(0xFA000000)], _RIM_IOS,
                   radii=radii, top_only=False, parts=parts, backdrop=backdrop)
    return d, parts


def sheet_bg(dark):
    return sheet_bg_parts()[0]


def light_apply(parts, frac, band):
    """Кромка и верхний блик меняются при движении шторки (холодный свет -> тёплый)."""
    try:
        frac = max(0.0, min(1.0, frac))
        hr, hg, hb = mix(0xEA, 0xFF, frac), mix(0xF2, 0xE6, frac), mix(0xFF, 0xD2, frac)
        tl = 255 * (1.0 - 0.5 * frac)
        brc = 230 * (0.5 + 0.5 * frac)
        rim = [argb(tl, hr, hg, hb), argb(0x26, 255, 255, 255), argb(0x0D, 255, 255, 255),
               argb(0x59, hr, hg, hb), argb(brc, hr, hg, hb)]
        parts["rim"].setColors(jarray(jint)(rim))
        parts["top"].setColors(jarray(jint)([argb(0x2A * (1.0 - 0.6 * frac), hr, hg, hb), 0x00FFFFFF]))
    except Exception as e:
        log("RichFrog light: " + str(e))


def theme_colors():
    """Палитра плагина: чёрное стекло и серые кнопки (не зависит от темы Telegram)."""
    _DARK[0] = True
    _ACC[0] = BLUE
    return {
        "accent": BLUE, "text": signed(0xFFFFFFFF), "gray": signed(0xFF9A9AA2),
        "card": signed(0xCC000000), "track": signed(0xFF3A3A3E),
        "chip": signed(0xCC000000), "dark": True, "ink": signed(0xFF111113),
    }


def opaque(c):
    """Цвета фонов в TL приходят как RGB без альфы -> делаем непрозрачными."""
    return signed(0xFF000000 | (int(c) & 0xFFFFFF))


def signed(c):
    c = int(c)
    return c - (1 << 32) if c >= (1 << 31) else c


def rounded(color, radius_dp):
    g = GradientDrawable()
    g.setColor(signed(color))
    g.setCornerRadius(float(dp(radius_dp)))
    return g


class _OutlineSpan(dynamic_proxy(jclass("android.text.style.LineBackgroundSpan"))):
    """Рисует контур букв позади самого текста: чёткая стеклянная обводка без размытия."""

    def __init__(self, align):
        super().__init__()
        self.align = align

    def drawBackground(self, canvas, paint, left, right, top, baseline, bottom, text, start, end, lnum):
        try:
            p = Paint(paint)
            p.setStyle(Paint.Style.STROKE)
            p.setStrokeWidth(float(dp(1.3)))
            p.setStrokeJoin(Paint.Join.ROUND)
            p.setColor(signed(0xA0E6F0FF))
            p.setShadowLayer(0.0, 0.0, 0.0, 0)
            w = float(p.measureText(text, int(start), int(end)))
            if self.align == 1:
                x = float(left) + (float(right) - float(left) - w) / 2.0
            elif self.align == 2:
                x = float(right) - w
            else:
                x = float(left)
            canvas.drawText(text, int(start), int(end), x, float(baseline), p)
        except Exception:
            pass


def set_out(t, text):
    """setText с контуром. Выравнивание берётся из gravity вью."""
    try:
        from android.text import SpannableString
        txt = str(text)
        h = int(t.getGravity()) & 7
        align = 1 if h == 1 else (2 if h == 5 else 0)
        sp = SpannableString(txt)
        if len(txt) > 0:
            sp.setSpan(_OutlineSpan(align), 0, len(txt), 33)
        t.setText(sp)
    except Exception:
        t.setText(str(text))


def make_text(ctx, text, size, color, bold=False, gravity=None):
    t = TextView(ctx)
    t.setTextSize(float(size))
    t.setTextColor(signed(color))
    if bold:
        t.setTypeface(Typeface.DEFAULT_BOLD)
    if gravity is not None:
        t.setGravity(gravity)
    set_out(t, text)
    return t


def lin(w=-2, h=-2, wt=None, m=(0, 0, 0, 0)):
    p = LinearLayout.LayoutParams(w, h) if wt is None else LinearLayout.LayoutParams(w, h, float(wt))
    p.setMargins(dp(m[0]), dp(m[1]), dp(m[2]), dp(m[3]))
    return p


def frm(w=-2, h=-2, gravity=None, m=(0, 0, 0, 0)):
    p = FrameLayout.LayoutParams(w, h) if gravity is None else FrameLayout.LayoutParams(w, h, gravity)
    p.setMargins(dp(m[0]), dp(m[1]), dp(m[2]), dp(m[3]))
    return p


def _show_toast(text):
    try:
        from android.widget import Toast
        from org.telegram.messenger import ApplicationLoader
        Toast.makeText(ApplicationLoader.applicationContext, str(text), Toast.LENGTH_LONG).show()
    except Exception as e:
        log("toast fail: " + str(e))


_LAST_ERR = [""]


def guarded(fn):
    """Любая ошибка внутри -> в лог и на экран (раньше глоталась молча)."""
    def wrap(*a, **kw):
        try:
            return fn(*a, **kw)
        except Exception as e:
            tb = traceback.format_exc()
            log("RichFrog ERROR in %s:\n%s" % (fn.__name__, tb))
            try:
                _LAST_ERR[0] = "%s: %s" % (fn.__name__, str(e)[:160])
            except Exception:
                pass
            where = ""
            try:
                frames = [f for f in traceback.extract_tb(e.__traceback__) if "rating" in str(f.filename).lower() or True]
                f = frames[-1]
                where = "\nстрока %s: %s" % (f.lineno, str(f.line)[:80])
            except Exception:
                pass
            msg = str(e).strip().splitlines()
            head = (msg[0] if msg else type(e).__name__)[:90]
            _show_toast("Ошибка в %s%s: %s" % (fn.__name__, where.replace("\nстрока ", " (стр. ").split(":")[0] + ")" if where else "", head))
    wrap.__name__ = fn.__name__
    return wrap


class _Click(dynamic_proxy(View.OnClickListener)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onClick(self, v):
        guarded(self.fn)(v)


class _Seek(dynamic_proxy(SeekBar.OnSeekBarChangeListener)):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onProgressChanged(self, sb, progress, from_user):
        try:
            if from_user:
                self.fn(int(progress))
        except Exception as e:
            log("RichFrog seek error: " + str(e))

    def onStartTrackingTouch(self, sb):
        pass

    def onStopTrackingTouch(self, sb):
        pass


def emph_dec():
    """Material 3 emphasized decelerate: быстрый старт, очень мягкая остановка (появление)."""
    try:
        return PathInterpolator(0.05, 0.7, 0.1, 1.0)
    except Exception:
        return DecelerateInterpolator(2.0)


def emph_acc():
    """Material 3 emphasized accelerate (уход)."""
    try:
        return PathInterpolator(0.3, 0.0, 0.8, 0.15)
    except Exception:
        return AccelerateInterpolator(1.4)


def std_ease():
    """Material 3 standard (смена содержимого)."""
    try:
        return PathInterpolator(0.2, 0.0, 0.0, 1.0)
    except Exception:
        return DecelerateInterpolator(1.6)


def spring_scale(v, target, stiffness, damping):
    """Пружина по Material 3 (androidx.dynamicanimation); если недоступна - возвращает False."""
    try:
        from androidx.dynamicanimation.animation import SpringAnimation, SpringForce, DynamicAnimation
        for prop in (DynamicAnimation.SCALE_X, DynamicAnimation.SCALE_Y):
            anim = SpringAnimation(v, prop)
            force = SpringForce(float(target))
            force.setStiffness(float(stiffness))
            force.setDampingRatio(float(damping))
            anim.setSpring(force)
            anim.start()
        return True
    except Exception:
        return False


class _Touch(dynamic_proxy(View.OnTouchListener)):
    """Жидкое «нажатие»: плитка вдавливается и пружинит обратно с перелётом."""

    def onTouch(self, v, e):
        try:
            a = int(e.getActionMasked())
            if a == 0:
                v.animate().cancel()
                if not spring_scale(v, 0.97, 1500.0, 1.0):
                    v.animate().setStartDelay(0).scaleX(0.97).scaleY(0.97).setDuration(100).setInterpolator(
                        emph_dec()).start()
            elif a == 1 or a == 3:
                # критическое демпфирование: возвращается ровно в 1.0, без перелёта за границы (раньше упиралось в края)
                if not spring_scale(v, 1.0, 700.0, 1.0):
                    v.animate().setStartDelay(0).scaleX(1.0).scaleY(1.0).setDuration(160).setInterpolator(
                        std_ease()).start()
        except Exception:
            pass
        return False


class _AnimUpdate(dynamic_proxy(jclass("android.animation.ValueAnimator$AnimatorUpdateListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onAnimationUpdate(self, anim):
        try:
            self.fn(float(anim.getAnimatedFraction()))
        except Exception:
            pass


class _DismissL(dynamic_proxy(jclass("android.content.DialogInterface$OnDismissListener"))):
    def __init__(self, fn):
        super().__init__()
        self.fn = fn

    def onDismiss(self, dialog):
        try:
            self.fn()
        except Exception:
            pass


class _KbLayout(dynamic_proxy(View.OnLayoutChangeListener)):
    """Окно ужимается/растягивается при показе/скрытии клавиатуры (adjustResize) — шторка прыгала.
    Гасим скачок: ставим её на прежнее место и плавно едем на новое."""

    def __init__(self, plugin, wrap):
        super().__init__()
        self.plugin = plugin
        self.wrap = wrap

    def onLayoutChange(self, v, left, top, right, bottom, oldLeft, oldTop, oldRight, oldBottom):
        try:
            nh, oh = int(bottom - top), int(oldBottom - oldTop)
            if oh <= 0 or nh == oh or nh <= 0:
                return
            pl = self.plugin
            if getattr(pl, "_sheet_closing", False) or time.time() - getattr(pl, "_open_t", 0.0) < 0.55:
                return
            delta = float(nh - oh)          # < 0 — клавиатура появилась, > 0 — спряталась
            self.wrap.animate().cancel()
            self.wrap.setTranslationY(float(self.wrap.getTranslationY()) - delta)
            self.wrap.animate().setStartDelay(0).translationY(0.0).setDuration(280).setInterpolator(
                emph_dec()).setUpdateListener(_AnimUpdate(lambda f: pl._sheet_light())).start()
        except Exception as e:
            log("RichFrog kb layout: " + str(e))


class _Drag(dynamic_proxy(View.OnTouchListener)):
    """Тянешь за ручку шторки вниз - она следует за пальцем и закрывается/пружинит назад."""

    def __init__(self, plugin, wrap):
        super().__init__()
        self.plugin = plugin
        self.wrap = wrap
        self.y0 = 0.0

    def onTouch(self, v, e):
        try:
            a = int(e.getActionMasked())
            if a == 0:
                self.wrap.animate().cancel()
                self.y0 = float(e.getRawY()) - float(self.wrap.getTranslationY())
            elif a == 2:
                self.wrap.setTranslationY(max(0.0, float(e.getRawY()) - self.y0))
                self.plugin._sheet_light()
            elif a == 1 or a == 3:
                if float(self.wrap.getTranslationY()) > dp(110):
                    self.plugin.close_sheet()
                else:
                    self.wrap.animate().setStartDelay(0).translationY(0.0).setDuration(420).setInterpolator(
                        OvershootInterpolator(1.8)).setUpdateListener(
                        _AnimUpdate(lambda f: self.plugin._sheet_light())).start()
        except Exception as ex:
            log("RichFrog drag error: " + str(ex))
        return True


class _SwitchTouch(dynamic_proxy(View.OnTouchListener)):
    """Пока палец на переключателе, бегунок растягивается, как в iOS."""

    def __init__(self, thumb):
        super().__init__()
        self.thumb = thumb

    def onTouch(self, v, e):
        try:
            a = int(e.getActionMasked())
            if a == 0:
                self.thumb.animate().cancel()
                self.thumb.animate().setStartDelay(0).scaleX(1.22).scaleY(1.08).setDuration(160).setInterpolator(
                    emph_dec()).start()
            elif a == 1 or a == 3:
                self.thumb.animate().setStartDelay(0).scaleX(1.0).scaleY(1.0).setDuration(360).setInterpolator(
                    OvershootInterpolator(2.2)).start()
        except Exception:
            pass
        return False


def ios_switch(ctx, checked):
    """Переключатель в стиле iOS Liquid Glass. Возвращает (вью, set_checked(value, animate), thumb)."""
    TW, TH, KW, KH, PAD = 62, 34, 40, 28, 3
    travel = float(dp(TW - KW - PAD * 2))
    box = FrameLayout(ctx)
    tr = float(dp(TH)) / 2.0
    w = max(1, dp(1))
    rim = _grad([0xDDFFFFFF, 0x30FFFFFF, 0x30FFFFFF, 0xAAFFFFFF], "TL_BR", tr)
    body = _grad([0x6E8E8E93, 0x4A6E6E73], "TOP_BOTTOM", max(0.0, tr - w))
    track_d = LayerDrawable(jarray(Drawable)([rim, body]))
    track_d.setLayerInset(1, w, w, w, w)
    track = View(ctx)
    track.setBackground(track_d)
    box.addView(track, frm(dp(TW), dp(TH)))
    kr = float(dp(KH)) / 2.0
    k_rim = _grad([0xFFFFFFFF, 0x99FFFFFF, 0xCCFFFFFF], "TL_BR", kr)
    k_body = _grad([0xFFFFFFFF, 0xE6E4E4EA], "TOP_BOTTOM", max(0.0, kr - w))
    thumb_d = LayerDrawable(jarray(Drawable)([k_rim, k_body]))
    thumb_d.setLayerInset(1, w, w, w, w)
    thumb = View(ctx)
    thumb.setBackground(thumb_d)
    box.addView(thumb, frm(dp(KW), dp(KH), Gravity.LEFT | Gravity.CENTER_VERTICAL, (PAD, 0, 0, 0)))

    OFF = ((0x6E, 0x8E, 0x8E, 0x93), (0x4A, 0x6E, 0x6E, 0x73))
    ON = ((0xE6, 0x34, 0xC7, 0x59), (0xC8, 0x2A, 0xA8, 0x4A))
    state = {"f": 1.0 if checked else 0.0, "anim": None}

    def apply(f):
        state["f"] = f
        cols = []
        for i in (0, 1):
            cols.append(argb(*[mix(OFF[i][j], ON[i][j], f) for j in range(4)]))
        body.setColors(jarray(jint)(cols))
        thumb.setTranslationX(travel * f)

    def set_checked(value, animate=True):
        target = 1.0 if value else 0.0
        start = state["f"]
        if state["anim"] is not None:
            try:
                state["anim"].cancel()
            except Exception:
                pass
        if not animate or start == target:
            apply(target)
            return
        va = ValueAnimator.ofFloat(0.0, 1.0)
        va.setDuration(360)
        va.setInterpolator(emph_dec())
        va.addUpdateListener(_AnimUpdate(lambda fr: apply(start + (target - start) * fr)))
        state["anim"] = va
        va.start()

    apply(state["f"])
    return box, set_checked, thumb


def _arrow_glyph(ctx, kind, color, size_dp, box_dp):
    box = FrameLayout(ctx)
    box.setClickable(True)
    t = make_text(ctx, "‹" if kind == "left" else "›", int(size_dp * 1.9), color, True, Gravity.CENTER)
    box.addView(t, frm(-1, -1, Gravity.CENTER))
    return box


def _icon_bars(ctx, segs, color, size_dp, stroke_u=3.3):
    """Иконка из скруглённых полосок в сетке 24x24. Центр рисунка = центр вью."""
    S = float(dp(size_dp))
    k = S / 24.0
    T = max(2, int(round(stroke_u * k)))
    holder = FrameLayout(ctx)
    for x1, y1, x2, y2 in segs:
        x1, y1, x2, y2 = x1 * k, y1 * k, x2 * k, y2 * k
        L = int(round(math.hypot(x2 - x1, y2 - y1) + T))
        v = View(ctx)
        g = GradientDrawable()
        g.setColor(signed(color))
        g.setCornerRadius(float(T) / 2.0)
        v.setBackground(g)
        holder.addView(v, frm(L, T, Gravity.LEFT | Gravity.TOP))
        v.setTranslationX(float((x1 + x2) / 2.0 - L / 2.0))
        v.setTranslationY(float((y1 + y2) / 2.0 - T / 2.0))
        v.setRotation(float(math.degrees(math.atan2(y2 - y1, x2 - x1))))
    return holder


_ICON_SEGS = {
    "left": [(19.0, 12.0, 5.5, 12.0), (11.5, 5.5, 5.0, 12.0), (5.0, 12.0, 11.5, 18.5)],
    "right": [(5.0, 12.0, 18.5, 12.0), (12.5, 5.5, 19.0, 12.0), (19.0, 12.0, 12.5, 18.5)],
    "check": [(5.2, 12.3, 10.0, 17.1), (10.0, 17.1, 18.8, 7.3)],
}


def arrow_btn(ctx, kind, color, size_dp=18, box_dp=40):
    """Иконка-кнопка строго по центру своего места. kind: 'left' | 'right' | 'check'."""
    try:
        icon = _icon_bars(ctx, _ICON_SEGS[kind], color, size_dp)
        box = FrameLayout(ctx)
        box.setClickable(True)
        box.addView(icon, frm(dp(size_dp), dp(size_dp), Gravity.CENTER))
        return box
    except Exception as e:
        log("RichFrog icon fallback: " + str(e))
        return _arrow_glyph(ctx, "left" if kind == "left" else "right", color, size_dp, box_dp)


def switch_row(ctx, C, label, getter, setter):
    """Строка «подпись + iOS-переключатель» на стеклянной карточке."""
    row = LinearLayout(ctx)
    row.setOrientation(LinearLayout.HORIZONTAL)
    row.setGravity(Gravity.CENTER_VERTICAL)
    set_bg(row, glass(C["card"], 22))
    row.setPadding(dp(16), dp(8), dp(12), dp(8))
    row.addView(make_text(ctx, label, 17, C["text"]), lin(0, -2, 1))
    sw, set_checked, thumb = ios_switch(ctx, bool(getter()))
    row.addView(sw, lin(-2, -2))

    def flip(v):
        new = not bool(getter())
        setter(new)
        set_checked(new, True)

    on_click(row, flip, False)
    row.setOnTouchListener(_SwitchTouch(thumb))
    return row


_TOUCH = []


def on_click(view, fn, press=True):
    view.setOnClickListener(_Click(fn))
    if press:
        try:
            if not _TOUCH:
                _TOUCH.append(_Touch())
            view.setOnTouchListener(_TOUCH[0])
        except Exception:
            pass


# ======================================================================
# Значки уровней (как на фото: 1 щит, 2 квадрат, 3 щит, 4 ромб, 5.. многоугольники, 10+ розетка)
# ======================================================================
def _rounded_poly(pts, t):
    path = Path()
    n = len(pts)
    for i in range(n):
        p_prev = pts[(i - 1) % n]
        p = pts[i]
        p_next = pts[(i + 1) % n]
        a = (p[0] + (p_prev[0] - p[0]) * t, p[1] + (p_prev[1] - p[1]) * t)
        b = (p[0] + (p_next[0] - p[0]) * t, p[1] + (p_next[1] - p[1]) * t)
        if i == 0:
            path.moveTo(float(a[0]), float(a[1]))
        else:
            path.lineTo(float(a[0]), float(a[1]))
        path.quadTo(float(p[0]), float(p[1]), float(b[0]), float(b[1]))
    path.close()
    return path


def _regular_poly(n, radius=43.0, cx=50.0, cy=52.0, start=-math.pi / 2):
    pts = []
    for i in range(n):
        ang = start + 2 * math.pi * i / n
        pts.append((cx + radius * math.cos(ang), cy + radius * math.sin(ang)))
    return pts


def _fit(pts, size=80.0):
    xs = [p[0] for p in pts]
    ys = [p[1] for p in pts]
    k = size / max(max(xs) - min(xs), max(ys) - min(ys))
    cx = (max(xs) + min(xs)) / 2.0
    cy = (max(ys) + min(ys)) / 2.0
    return [(50.0 + (x - cx) * k, 50.0 + (y - cy) * k) for x, y in pts]


def _bez(p0, c, p1, n=10):
    out = []
    for i in range(1, n + 1):
        t = i / float(n)
        u = 1.0 - t
        out.append((u * u * p0[0] + 2 * u * t * c[0] + t * t * p1[0],
                    u * u * p0[1] + 2 * u * t * c[1] + t * t * p1[1]))
    return out


